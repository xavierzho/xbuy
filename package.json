{
  "name": "rushbuy",
  "private": true,
  "version": "1.0.0",
  "description": "Rushbuy monorepo — Node 按领域划分在 nodejs/，一次 npm install",
  "workspaces": [
    "nodejs/shared",
    "nodejs/bb",
    "nodejs/gdx",
    "nodejs/bangcle",
    "nodejs/http-bridge",
    "nodejs/bs-dvid",
    "nodejs/yidun-local"
  ],
  "scripts": {
    "bridge:start": "npm run start -w moutai-http-bridge",
    "bb:check": "node nodejs/bb/update.cjs --check",
    "bb:sync": "node nodejs/bb/update.cjs --sync",
    "bb:auto": "node nodejs/bb/update.cjs --auto",
    "gdx:cookie": "node nodejs/gdx/gdx_cookie.cjs",
    "bangcle:warmup": "node nodejs/bangcle/bangcle_warmup.cjs",
    "bs-dvid": "node nodejs/bs-dvid/cli.js",
    "yidun:local": "node nodejs/yidun-local/app_api.js"
  },
  "engines": {
    "node": ">=18"
  }
}
