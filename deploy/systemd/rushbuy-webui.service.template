[Unit]
Description=rushbuy WebUI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
Environment=MT_WEBUI_BIND=0.0.0.0
Environment=MT_WEBUI_PORT=8989
Environment=MT_DIST_WS_PORT=8765
Environment=MT_GO_BRIDGE_PORT=19091
Environment=MT_HTTP_BACKEND=node
Environment=MT_RUSH_HTTP_NODE=1
Environment=MT_BATCH_RUSH_NODE=1
Environment=MT_CURL_WORKER_POOL=1
ExecStart=__PROJECT_DIR__/scripts/run_webui.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
