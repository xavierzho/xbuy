[Unit]
Description=Rushbuy Distributed Worker %i
Wants=network-online.target rushbuy-webui.service
After=network-online.target rushbuy-webui.service

[Service]
Type=simple
User=rushbuy
Group=rushbuy
WorkingDirectory=/opt/rushbuy

Environment=PYTHONUNBUFFERED=1
Environment=MT_DIST_MASTER_WS=ws://127.0.0.1:8765
Environment=MT_DIST_SKIP_DEP_CHECK=1

ExecStart=/opt/rushbuy/scripts/run_worker_instance.sh %i ${MT_DIST_MASTER_WS}

Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/rushbuy

[Install]
WantedBy=multi-user.target
