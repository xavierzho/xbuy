[Unit]
Description=Rushbuy WebUI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rushbuy
Group=rushbuy
WorkingDirectory=/opt/rushbuy

Environment=PYTHONUNBUFFERED=1
Environment=MT_WEBUI_BIND=127.0.0.1
Environment=MT_WEBUI_PORT=8989
Environment=MT_DIST_WS_PORT=8765
Environment=MT_GO_BRIDGE_PORT=19091

Environment=MT_HTTP_BACKEND=node
Environment=MT_RUSH_HTTP_NODE=1
Environment=MT_BATCH_RUSH_NODE=1
Environment=MT_CURL_WORKER_POOL=1
Environment=MT_TLS_ENGINE=ja3_client

Environment=MT_PROXY_POOL_NO_DIRECT=1
Environment=MT_HF_ACCOUNT_STAGGER_MS=80

# named tunnel 由独立 cloudflared 服务管理，关闭程序内置 quick tunnel
Environment=MT_CLOUDFLARED_AUTOSTART=0
Environment=MT_CLOUDFLARED_PUBLIC_PAGES=0

ExecStart=/opt/rushbuy/scripts/run_webui.sh

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/rushbuy

[Install]
WantedBy=multi-user.target
